{
  "type": "module",
  "private": true,
  "scripts": {
    "build": "dotenv -e ./.env.production.local -v NODE_ENV=production -- nuxt build",
    "dev": "dotenv -e ./.env.development.local -v NODE_ENV=development -- nuxt dev",
    "generate": "dotenv -e ./.env.production.local -v NODE_ENV=production -- nuxt generate",
    "knip:deps": "dotenv -v SKIP_ENV_VALIDATION=true -- knip --dependencies",
    "knip:exports": "dotenv -v SKIP_ENV_VALIDATION=true -- knip --exports",
    "lint": "eslint --cache --concurrency=auto --max-warnings 0 && stylelint './{app,layers/*/app}/**/*.{css,scss,vue}' -i ./.gitignore --cache --max-warnings 0",
    "lint:fix": "eslint --cache --concurrency=auto --fix --max-warnings 0 && stylelint './{app,layers/*/app}/**/*.{css,scss,vue}' -i ./.gitignore --cache --fix --max-warnings 0",
    "postinstall": "dotenv -v SKIP_ENV_VALIDATION=true -- nuxt prepare",
    "preview": "nuxt preview",
    "typecheck": "dotenv -v SKIP_ENV_VALIDATION=true -- nuxt typecheck"
  },
  "dependencies": {
    "@kikiutils/nuxt": "^15.0.0",
    "@kikiutils/shared": "^20.1.3",
    "@nuxt/icon": "2.6.3",
    "@nuxt/image": "^2.2.1",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/seo": "^6.0.1",
    "@vite-pwa/nuxt": "2.0.3",
    "date-fns": "^4.4.0",
    "nuxt": "^4.6.4",
    "nuxt-security": "^2.7.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@kikiutils/eslint-config": "^11.2.0",
    "@kikiutils/stylelint-config": "^0.7.0",
    "@unocss/nuxt": "^66.13.0",
    "@vite-pwa/workbox-swkit": "^8.0.15",
    "dotenv-cli": "^11.1.0",
    "eslint": "^10.15.0",
    "knip": "^6.47.0",
    "sass-embedded": "^1.108.2",
    "stylelint": "^18.1.0",
    "tailwindcss": "^4.3.5",
    "unocss": "^66.13.0",
    "unplugin-fonts": "^2.1.0",
    "vue-tsc": "^3.3.14"
  }
}
