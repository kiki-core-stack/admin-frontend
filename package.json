{
  "type": "module",
  "private": true,
  "scripts": {
    "build": "dotenv -e ./.env.production.local -v NODE_ENV=production -- nuxt build",
    "dev": "dotenv -e ./.env.development.local -v NODE_ENV=development -- nuxt dev",
    "generate": "dotenv -e ./.env.production.local -v NODE_ENV=production -- nuxt generate",
    "knip:deps": "knip --dependencies",
    "knip:exports": "knip --exports",
    "lint": "eslint --max-warnings 0 && stylelint './app/**/*.{css,scss,vue}' -i ./.gitignore --mw 0",
    "lint:fix": "eslint --fix --max-warnings 0 && stylelint './app/**/*.{css,scss,vue}' -i ./.gitignore --fix --mw 0",
    "postinstall": "dotenv -v SKIP_ENV_VALIDATION=true -- nuxt prepare",
    "preview": "nuxt preview",
    "typecheck": "dotenv -v SKIP_ENV_VALIDATION=true -- nuxt typecheck"
  },
  "dependencies": {
    "@kikiutils/nuxt": "^13.0.0",
    "@kikiutils/shared": "^18.0.1",
    "@nuxt/icon": "2.5.1",
    "@nuxt/image": "^2.1.0",
    "@nuxtjs/seo": "^5.3.14",
    "@vite-pwa/nuxt": "1.1.1",
    "@vueuse/nuxt": "^14.4.0",
    "nuxt": "^4.5.2",
    "nuxt-security": "^2.6.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@eslint/css": "^2.0.0",
    "@html-eslint/parser": "^0.65.0",
    "@kikiutils/eslint-config": "^9.2.1",
    "@kikiutils/eslint-plugin-vue": "^10.10.0",
    "@kikiutils/stylelint-config": "^0.6.0",
    "@unocss/nuxt": "^66.10.2",
    "dotenv-cli": "^11.0.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-format": "^2.0.1",
    "knip": "^6.35.1",
    "tailwind-csstree": "^0.4.0",
    "tailwindcss": "^4.3.3",
    "unocss": "^66.10.2",
    "unplugin-fonts": "^2.0.0",
    "vue-eslint-parser": "^10.4.1"
  }
}
