{
  "type": "module",
  "private": true,
  "scripts": {
    "build": "dotenv -e ./.env.production.local -v NODE_ENV=production -- nuxt build",
    "dev": "dotenv -e ./.env.development.local -v NODE_ENV=development -- pnpm run dev:internal",
    "dev:internal": "bun run ./scripts/generate-permission-files.ts && nuxt dev",
    "generate": "dotenv -e ./.env.production.local -v NODE_ENV=production -- nuxt generate",
    "knip:deps": "knip --dependencies",
    "knip:exports": "knip --exports",
    "lint": "eslint --max-warnings 0 && stylelint './app/**/*.{css,scss,vue}' -i ./.gitignore --mw 0",
    "lint:fix": "eslint --fix --max-warnings 0 && stylelint './app/**/*.{css,scss,vue}' -i ./.gitignore --fix --mw 0",
    "postinstall": "dotenv -v SKIP_ENV_VALIDATION=true -- nuxt prepare",
    "preview": "nuxt preview",
    "typecheck": "dotenv -v SKIP_ENV_VALIDATION=true -- nuxt typecheck"
  },
  "dependencies": {
    "@element-plus/nuxt": "^1.1.5",
    "@kcs-project/pack": "github:kiki-core-stack/pack#b23dae8cb0fb9bf08dba746b28ff20446b35b98f",
    "@kikiutils/micromatch": "^4.0.9",
    "@kikiutils/nuxt": "^13.0.0",
    "@kikiutils/shared": "^19.0.0",
    "@nuxt/icon": "2.6.1",
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/robots": "^7.0.2",
    "@sylke/email-validation": "^1.0.0",
    "@vueuse/integrations": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "axios": "^1.20.0",
    "bowser": "^2.14.1",
    "date-fns": "^4.4.0",
    "element-plus": "^2.14.7",
    "es-toolkit": "^1.53.0",
    "html5-qrcode": "^2.3.8",
    "nanoid": "^6.0.2",
    "nuxt": "^4.6.2",
    "nuxt-security": "^2.7.0",
    "qrcode": "^1.5.4",
    "query-string": "^10.0.0",
    "sweetalert2": "^11.26.25",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@eslint/css": "^2.0.1",
    "@html-eslint/parser": "^0.67.0",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@iconify-json/mdi": "^1.2.3",
    "@kikiutils/eslint-config": "^9.3.2",
    "@kikiutils/eslint-plugin-vue": "^10.10.0",
    "@kikiutils/mongoose": "^9.0.1",
    "@kikiutils/stylelint-config": "^0.6.1",
    "@types/micromatch": "^4.0.10",
    "@types/qrcode": "^1.5.6",
    "@unocss/nuxt": "^66.11.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "eslint-plugin-format": "^2.0.1",
    "knip": "^6.43.0",
    "stylelint": "^17.16.0",
    "tailwind-csstree": "^0.4.1",
    "tailwindcss": "^4.3.3",
    "type-fest": "^5.10.0",
    "unocss": "^66.11.0",
    "unplugin-fonts": "^2.1.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
