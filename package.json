{
  "type": "module",
  "private": true,
  "scripts": {
    "build": "dotenv -v NODE_ENV=production -- nuxt build",
    "dev": "dotenv -e ./.env.development.local -v NODE_ENV=development -- pnpm run dev:internal",
    "dev:internal": "bun run ./scripts/generate-files.ts && nuxt dev",
    "generate": "dotenv -v NODE_ENV=production -- nuxt generate",
    "knip:deps": "dotenv -v SKIP_ENV_VALIDATION=true -- knip --dependencies",
    "knip:exports": "dotenv -v SKIP_ENV_VALIDATION=true -- knip --exports",
    "lint": "eslint --max-warnings 0 && stylelint './{app,layers/*/app}/**/*.{css,scss,vue}' -i ./.gitignore --max-warnings 0",
    "lint:fix": "eslint --fix --max-warnings 0 && stylelint './{app,layers/*/app}/**/*.{css,scss,vue}' -i ./.gitignore --fix --max-warnings 0",
    "postinstall": "dotenv -v SKIP_ENV_VALIDATION=true -- nuxt prepare",
    "preview": "nuxt preview",
    "typecheck": "dotenv -v SKIP_ENV_VALIDATION=true -- nuxt typecheck"
  },
  "dependencies": {
    "@element-plus/nuxt": "^1.1.5",
    "@kcs-project/pack": "github:kiki-core-stack/pack#ce8a5c93b5966ba48dd096a6aa1ea25d72e140a2",
    "@kikiutils/nuxt": "^16.0.0",
    "@kikiutils/shared": "^21.0.0",
    "@nuxt/icon": "2.6.3",
    "@nuxtjs/color-mode": "^4.1.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/robots": "^7.0.2",
    "@simplewebauthn/browser": "^14.0.0",
    "@vueuse/integrations": "^15.0.0",
    "axios": "^1.21.1",
    "bowser": "^2.15.0",
    "cropperjs": "^2.3.1",
    "element-plus": "^2.14.8",
    "es-toolkit": "^1.53.2",
    "html5-qrcode": "^2.3.8",
    "nanoid": "^6.0.2",
    "nuxt": "^4.6.4",
    "nuxt-security": "^2.7.0",
    "qrcode": "^1.5.4",
    "query-string": "^10.0.0",
    "sweetalert2": "^11.26.25",
    "ts-extras": "^3.0.0",
    "vue": "^3.5.46",
    "vue-i18n": "^11.4.23",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@iconify-json/mdi": "^1.2.3",
    "@kikiutils/eslint-config": "^11.2.0",
    "@kikiutils/mongoose": "^9.0.4",
    "@kikiutils/stylelint-config": "^0.7.0",
    "@types/qrcode": "^1.5.6",
    "@unocss/nuxt": "^66.13.0",
    "dotenv-cli": "^11.1.0",
    "eslint": "^10.15.0",
    "knip": "^6.47.0",
    "sass-embedded": "^1.108.2",
    "stylelint": "^18.1.0",
    "tailwindcss": "^4.3.5",
    "type-fest": "^6.0.3",
    "unocss": "^66.13.0",
    "unplugin-fonts": "^2.1.0",
    "vue-tsc": "^3.3.14"
  }
}
